# ========================================
# KhetConnect Production Environment Setup
# ========================================
# Copy this file to .env and fill in actual values
# DO NOT commit .env file to git

# ========================================
# DATABASE CONFIGURATION
# ========================================
# PostgreSQL Connection String (from Neon or your provider)
SPRING_DATASOURCE_URL=postgresql://user:password@host:5432/khetconnect

# Database credentials (use strong, unique password)
SPRING_DATASOURCE_USERNAME=khetconnect_user
SPRING_DATASOURCE_PASSWORD=generate_strong_password_32_chars_minimum

# Connection Pool Settings
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# ========================================
# SECURITY & JWT
# ========================================
# JWT Secret Key (CRITICAL: Must be 32+ random characters)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=generate_random_32_char_string_here_do_not_use_default

# JWT Token Expiration (milliseconds)
JWT_EXPIRY_MS=86400000

# CORS Allowed Origins (comma-separated, no wildcards)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ========================================
# FIREBASE / FCM CONFIGURATION
# ========================================
# Enable Firebase Cloud Messaging
KHETCONNECT_FCM_ENABLED=true

# Path to Firebase service account JSON (download from Firebase Console)
# Mount this file in Docker and set path: /app/firebase-key.json
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-key.json

# ========================================
# SERVER CONFIGURATION
# ========================================
# Server port
SERVER_PORT=8080

# Spring profiles (production, development, test)
SPRING_PROFILES_ACTIVE=production

# Session cookie security
SERVER_SERVLET_SESSION_COOKIE_SECURE=true

# ========================================
# LOGGING CONFIGURATION
# ========================================
# Logging level for root logger (WARN for production)
LOGGING_LEVEL_ROOT=WARN

# Logging level for KhetConnect logger (INFO for production)
LOGGING_LEVEL_KHETCONNECT=INFO

# Log file output path
LOGGING_FILE=/var/log/khetconnect/spring.log

# ========================================
# HIBERNATE / JPA CONFIGURATION
# ========================================
# DDL mode (validate, update, create, create-drop)
# MUST be 'validate' for production
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Show SQL statements (false for production)
SPRING_JPA_SHOW_SQL=false

# ========================================
# H2 CONSOLE (for development only)
# ========================================
# MUST be false for production
H2_CONSOLE_ENABLED=false

# ========================================
# MANAGEMENT & MONITORING
# ========================================
# Health endpoint details visibility
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# ========================================
# DOCKER DEPLOYMENT SPECIFIC
# ========================================
# Container name prefix
COMPOSE_PROJECT_NAME=khetconnect

# Image registry (if using private registry)
DOCKER_REGISTRY=docker.io

# ========================================
# FRONTEND CONFIGURATION
# ========================================
# Frontend API Base URL (set on Netlify/deployment platform)
VITE_API_URL=https://api.yourdomain.com/api

# Frontend API base path
VITE_API_BASE_PATH=/api/v1
